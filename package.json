{
  "name": "cytoid-notes-design",
  "type": "module",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm -C packages/notes build",
    "bake": "pnpm -C packages/notes bake",
    "dev": "pnpm -C playground dev",
    "build:playground": "pnpm -C playground build",
    "test": "vitest run",
    "test:watch": "vitest dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint",
    "fmt": "eslint --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^10.3.0",
    "jiti": "2.7.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
